# Copiar este archivo como `.env` (git lo ignora) y ajustar solo lo necesario.
# Lo leen tanto `docker compose` como Spring Boot (spring.config.import).

# --- Base de datos (PostgreSQL 16 en Docker) ---
POSTGRES_DB=omniretail
POSTGRES_USER=omniretail
POSTGRES_PASSWORD=omniretail_dev
POSTGRES_PORT=5432

# --- Backend ---
SERVER_PORT=8080

# Clave HS256 para firmar los JWT: minimo 32 caracteres.
# En dev tiene un valor por defecto; en prod es OBLIGATORIA (la app no arranca sin ella).
# JWT_SECRET=

# Origenes permitidos por CORS (separados por coma). Por defecto, el frontend Next.js local.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Mailpit (correo de desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Si Windows tiene reservado el 8025 (netsh interface ipv4 show excludedportrange protocol=tcp), usa otro, p. ej. 18025.

# --- Correo saliente (SMTP) ---
# En dev apunta a Mailpit (bandeja en http://localhost:8025). Usuario y clave son opcionales.
MAIL_HOST=localhost
MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM=no-reply@omniretail.local

# URL publica del frontend: base de los enlaces de verificacion y recuperacion en los correos.
FRONTEND_BASE_URL=http://localhost:3000
