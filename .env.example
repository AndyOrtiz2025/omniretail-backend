# Copiar este archivo como `.env` (git lo ignora) y ajustar solo lo necesario.
# Lo leen tanto `docker compose` como Spring Boot (spring.config.import).

# --- Base de datos (PostgreSQL 16 en Docker) ---
POSTGRES_DB=omniretail
POSTGRES_USER=omniretail
POSTGRES_PASSWORD=omniretail_dev
POSTGRES_PORT=5432

# --- Backend ---
SERVER_PORT=8080

# Clave HS256 para firmar los JWT: minimo 32 caracteres.
# En dev tiene un valor por defecto; en prod es OBLIGATORIA (la app no arranca sin ella).
# JWT_SECRET=

# Clave maestra de la verificacion en dos pasos (MFA): minimo 32 caracteres. De ella se derivan
# la clave AES-GCM que cifra el secreto TOTP y la clave HMAC de los codigos de recuperacion.
# En dev tiene un valor por defecto; en prod es OBLIGATORIA (la app no arranca sin ella).
# Si cambia, los secretos TOTP ya guardados dejan de poder descifrarse: no la rotes sin migrar.
# MFA_ENCRYPTION_KEY=

# Clave maestra que cifra la contrasena de aplicacion de Gmail de cada tenant (remitente de correos
# operativos) y los cuerpos de correo pendientes de reintento: minimo 32 caracteres.
# En dev tiene un valor por defecto; en prod es OBLIGATORIA (la app no arranca sin ella).
# Si cambia, las credenciales ya guardadas dejan de poder descifrarse: no la rotes sin migrar.
# EMAIL_CREDENTIAL_ENCRYPTION_KEY=

# Origenes permitidos por CORS (separados por coma). Por defecto, el frontend Next.js local.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Media local (JPEG/PNG/WebP). Las URLs persistidas siguen siendo relativas bajo /media/.
MEDIA_STORAGE_PATH=./data/media
MEDIA_MAX_SIZE_BYTES=5242880
MEDIA_MAX_FILE_SIZE=5MB
MEDIA_MAX_REQUEST_SIZE=6MB

# --- Mailpit (correo de desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Si Windows tiene reservado el 8025 (netsh interface ipv4 show excludedportrange protocol=tcp), usa otro, p. ej. 18025.

# --- Correo saliente (SMTP) ---
# En dev apunta a Mailpit (bandeja en http://localhost:8025). Usuario y clave son opcionales.
MAIL_HOST=localhost
MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM=no-reply@omniretail.local
# Autenticacion SMTP y STARTTLS: apagados por defecto (Mailpit no usa TLS).
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# Timeout de conexion, lectura y escritura en milisegundos.
# MAIL_SMTP_TIMEOUT_MILLIS=10000
#
# Ejemplo para enviar por Gmail (contrasena de aplicacion de 16 letras, SIN espacios).
# El remitente debe ser la misma cuenta de Gmail: Gmail reemplaza cualquier otro "De:".
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=abcdefghijklmnop
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=OmniRetail <tu-cuenta@gmail.com>

# URL publica del frontend: base de los enlaces de verificacion y recuperacion en los correos.
FRONTEND_BASE_URL=http://localhost:3000

# --- Correos operativos por tenant (Gmail SMTP) ---
# Reintento de los que fallan por transporte. Valores por defecto: ver application.yaml (app.mail.delivery.*).
# EMAIL_RETRY_ENABLED=true
# EMAIL_RETRY_MAX_ATTEMPTS=5
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
