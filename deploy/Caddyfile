# Reverse proxy de produccion. El esquema HTTPS fijo rechaza valores heredados como :80 o http://dominio.
https://{$SITE_ADDRESS} {
	encode zstd gzip

	# API REST del backend (la usa la app movil directamente; la web pasa por sus propios Route Handlers).
	handle /api/v1/* {
		reverse_proxy backend:8080 {
			# Caddy descarta los X-Forwarded-* suministrados por el cliente; fijamos la IP remota que usara el limiter.
			header_up X-Forwarded-For {remote_host}
	}
	}

	# Archivos de media servidos por el backend.
	handle /media/* {
		reverse_proxy backend:8080
	}

	# Tope del cuerpo antes de llegar a Next.js o Spring (multipart max-request-size = 6MB): mas grande -> 413.
	request_body {
		max_size 6MB
	}

	# Cabeceras de seguridad comunes. CSP se aplica en el borde para web, API y media.
	# Next.js necesita scripts y estilos inline; Google Identity Services carga recursos puntuales de accounts.google.com.
	# Las imagenes http(s) se mantienen por compatibilidad con catalogos remotos existentes.
	# HSTS solo tiene efecto sobre HTTPS; los navegadores lo ignoran en HTTP.
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https: http:; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
		-Server
	}

	# Todo lo demas es el frontend Next.js (incluye sus rutas /api/auth, /api/media, etc.).
	handle {
		reverse_proxy web:3000
	}
}
