# Plantilla del archivo de secretos de produccion.
# En el VPS:  cp env.prod.example /opt/omniretail/.env  y completar. NUNCA subir el .env real a git ni a GitHub.
# Generar cada clave larga con:  openssl rand -base64 48

# --- Direccion publica ---
# Solo IP: deja SITE_ADDRESS=:80 y usa http://<IP> abajo.
# Con dominio: SITE_ADDRESS=tienda.midominio.com y usa https://tienda.midominio.com abajo (HTTPS automatico).
SITE_ADDRESS=:80
FRONTEND_BASE_URL=http://203.0.113.10
CORS_ALLOWED_ORIGINS=http://203.0.113.10

# --- Imagenes (normalmente no se tocan) ---
# Para volver a una version anterior: BACKEND_TAG=sha-abc1234 y `docker compose -f docker-compose.prod.yml up -d`.
# BACKEND_IMAGE=ghcr.io/andyortiz2025/omniretail-backend
# BACKEND_TAG=latest
# WEB_IMAGE=ghcr.io/omniretail-project/omniretail-web
# WEB_TAG=latest

# --- Base de datos ---
POSTGRES_DB=omniretail
POSTGRES_USER=omniretail
POSTGRES_PASSWORD=

# --- Claves obligatorias del perfil prod (minimo 32 caracteres; la app no arranca sin ellas) ---
# No las rotes sin migrar: MFA y credenciales de correo cifradas dejarian de poder descifrarse.
JWT_SECRET=
MFA_ENCRYPTION_KEY=
EMAIL_CREDENTIAL_ENCRYPTION_KEY=

# --- Login con Google (opcional; requiere HTTPS/dominio como origen autorizado) ---
# GOOGLE_CLIENT_ID=

# --- Correo saliente (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=OmniRetail <tu-cuenta@gmail.com>

# --- Media ---
MEDIA_MAX_SIZE_BYTES=5242880
MEDIA_MAX_FILE_SIZE=5MB
MEDIA_MAX_REQUEST_SIZE=6MB
