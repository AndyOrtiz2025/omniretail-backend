# Plantilla del archivo de secretos de produccion.
# En el VPS:  cp env.prod.example /opt/omniretail/.env  y completar. NUNCA subir el .env real a git ni a GitHub.
# Generar cada clave larga con:  openssl rand -base64 48

# --- Direccion publica ---
# Usa un dominio publico con DNS apuntando al VPS. Caddy emite TLS y redirige HTTP a HTTPS automaticamente.
# No se admite despliegue de produccion solo con IP ni con HTTP plano.
SITE_ADDRESS=tienda.midominio.com
FRONTEND_BASE_URL=https://tienda.midominio.com
CORS_ALLOWED_ORIGINS=https://tienda.midominio.com

# --- Imagenes (normalmente no se tocan) ---
# Para volver a una version anterior: BACKEND_TAG=sha-abc1234 y `docker compose -f docker-compose.prod.yml up -d`.
# BACKEND_IMAGE=ghcr.io/andyortiz2025/omniretail-backend
# BACKEND_TAG=latest
# WEB_IMAGE=ghcr.io/omniretail-project/omniretail-web
# WEB_TAG=latest

# --- Base de datos ---
POSTGRES_DB=omniretail
POSTGRES_USER=omniretail
POSTGRES_PASSWORD=

# --- Claves obligatorias del perfil prod (minimo 32 caracteres; la app no arranca sin ellas) ---
# No las rotes sin migrar: MFA y credenciales de correo cifradas dejarian de poder descifrarse.
JWT_SECRET=
MFA_ENCRYPTION_KEY=
EMAIL_CREDENTIAL_ENCRYPTION_KEY=

# --- Login con Google (opcional; requiere HTTPS/dominio como origen autorizado) ---
# GOOGLE_CLIENT_ID=

# --- Correo saliente (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=OmniRetail <tu-cuenta@gmail.com>

# --- Monitoreo (Grafana) ---
# Grafana solo se publica en 127.0.0.1 del VPS (tunel SSH). Las alertas salen por el SMTP de arriba.
GRAFANA_ADMIN_PASSWORD=
# Uno o varios correos separados por ";".
ALERT_EMAIL_TO=
# Usuario de solo lectura (rol pg_monitor) para postgres-exporter. El CD lo crea o actualiza en cada despliegue.
# Sin comillas. Generar con:  openssl rand -base64 32
# POSTGRES_EXPORTER_USER=omniretail_monitor
POSTGRES_EXPORTER_PASSWORD=

# --- Media ---
MEDIA_MAX_SIZE_BYTES=5242880
MEDIA_MAX_FILE_SIZE=5MB
MEDIA_MAX_REQUEST_SIZE=6MB
